import dotenv from "dotenv";
import fetch from "node-fetch";
import crypto from "crypto";

dotenv.config();

const {
  MT_API_BASE = "https://app.moderntreasury.com/api",
  MT_API_KEY,
  LEDGER_ACCOUNT_ID,
} = process.env;

if (!LEDGER_ACCOUNT_ID) {
  console.error("Missing LEDGER_ACCOUNT_ID in .env");
  process.exit(1);
}

const BASE_DEPOSIT = 250000.0;   // USD
const PROCESSING_FEE = 150.0;    // USD
const IDEMPOTENCY_KEY = crypto.randomUUID();

function buildLedgerTransaction(base, fee) {
  const amount = Math.round(base * 100); // cents
  const feeCents = Math.round(fee * 100);
  const netCents = amount - feeCents;

  return {
    idempotency_key: IDEMPOTENCY_KEY,
    description: "FEIC deposit including processing fee",
    effective_at: new Date().toISOString(),
    ledger_entries: [
      {
        amount,
        direction: "credit",
        ledger_account_id: LEDGER_ACCOUNT_ID,
        metadata: { type: "deposit" },
      },
      {
        amount: netCents,
        direction: "debit",
        ledger_account_id: "ledger_account_cash_pool",
        metadata: { type: "net_allocation" },
      },
      {
        amount: feeCents,
        direction: "debit",
        ledger_account_id: "ledger_account_processing_fees",
        metadata: { type: "processing_fee" },
      },
    ],
    metadata: {
      total_usd: base,
      fee_usd: fee,
      project: "Reown c2d4e32876d0a4df63c8406820361d3b",
    },
  };
}

async function postToModernTreasury(transaction) {
  const url = `${MT_API_BASE}/ledger_transactions`;
  const body = JSON.stringify(transaction, null, 2);

  console.log("[DRY RUN] Would POST to:", url);
  console.log(body);

  // Uncomment to perform real post
  /*
  const res = await fetch(url, {
    method: "POST",
    headers: {
      "Authorization": `Basic ${Buffer.from(MT_API_KEY + ":").toString("base64")}`,
      "Content-Type": "application/json",
    },
    body,
  });
  if (!res.ok) throw new Error(`HTTP ${res.status}: ${await res.text()}`);
  return await res.json();
  */

  return { dryRun: true, payload: transaction };
}

(async () => {
  const tx = buildLedgerTransaction(BASE_DEPOSIT, PROCESSING_FEE);
  const result = await postToModernTreasury(tx);
  console.log("Transaction result:", result);
})();

def junos_vlan_and_ospf_config(tm6z_password: str) -> List[str]:
    """
    Return a list of Junos 'set' style configuration commands for junos 'configure merge' mode.
    We will push them using `send_config_set` or via the CLI-friendly 'set' lines.
    """
    cmds = [
        "configure",
        "set system host-name SW2-Core",
        # Create user TM6Z
        f"set system login user TM6Z class super-user authentication plain-text-password",
        # The password will be provided interactively by Netmiko send_command_timing
        # VLAN and IRB
        "set vlans VLAN20 vlan-id 20",
        "set vlans VLAN20 l3-interface irb.20",
        "set interfaces ge-0/0/2 description Uplink_to_core",
        "set interfaces ge-0/0/2 unit 0 family ethernet-switching port-mode trunk",
        "set interfaces ge-0/0/2 unit 0 family ethernet-switching vlan members VLAN20",
        "set interfaces irb unit 20 family inet address 10.10.20.1/24",
        # OSPF for interop with Junos (EIGRP is Cisco-only; using OSPF here)
        "set protocols ospf area 0 interface irb.20",
        "commit and-quit"
    ]
    return cmds
